    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const data = item.json;\n\n  const isYouTube =\n    String(data.id || '').startsWith('yt:video:') ||\n    String(data.link || '').includes('youtube.com');\n\n  const rawContent =\n    data['content:encodedSnippet'] ||\n    data.contentSnippet ||\n    data.description ||\n    data.content ||\n    data.title ||\n    '';\n\n  const cleanContent = String(rawContent)\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&#39;/gi, \"'\")\n    .replace(/&quot;/gi, '\"')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 2000);\n\n  return {\n    json: {\n      title: data.title || 'Untitled',\n\n      link: data.link || '',\n\n      published_date:\n        data.isoDate ||\n        data.pubDate ||\n        data.date ||\n        new Date().toISOString(),\n\n      source: isYouTube\n        ? `YouTube - ${data.author || 'Unknown Channel'}`\n        : `Blog - ${data.creator || data['dc:creator'] || 'HubSpot'}`,\n\n      source_type: isYouTube ? 'YouTube' : 'Blog',\n\n      content: cleanContent,\n\n      unique_key:\n        data.link ||\n        data.id ||\n        `${data.title || ''}-${data.pubDate || data.date || ''}`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        -80
      ],
      "id": "e523af5b-69cf-408e-bfcd-f6692acc2fd5",
      "name": "Clean and Normalize Content"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst uniqueItems = [];\n\nfor (const item of items) {\n  const key = String(\n    item.json.unique_key ||\n    item.json.link ||\n    item.json.title ||\n    ''\n  )\n    .toLowerCase()\n    .trim();\n\n  if (!key) {\n    continue;\n  }\n\n  if (seen.has(key)) {\n    continue;\n  }\n\n  seen.add(key);\n  uniqueItems.push(item);\n}\n\nreturn uniqueItems.slice(0, 5);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
